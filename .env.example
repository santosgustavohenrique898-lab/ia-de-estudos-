# Obrigatória para gerar aulas a partir de PDF ou tema (não precisa no modo --demo)
ANTHROPIC_API_KEY=
# Modelo usado no roteiro e na checagem
CLAUDE_MODEL=claude-opus-5-5

# Opcional: voz. Sem chave, o vídeo sai sem áudio, com legenda no ritmo estimado.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opcional: caminho do Chrome/Chromium usado pelo render
CHROME_PATH=
