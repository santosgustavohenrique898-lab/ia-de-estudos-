# Obrigatória: a IA que pesquisa e escreve as aulas (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo usado no roteiro e na checagem
CLAUDE_MODEL=claude-opus-5-5

# Voz humana (https://elevenlabs.io). Sem ela, o site usa a voz do navegador.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opcional: caminho do Chrome/Chromium usado pelo render
CHROME_PATH=

# Opcional: limite de aulas por pessoa por hora
AULAS_POR_HORA=10
